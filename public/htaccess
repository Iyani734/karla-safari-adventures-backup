# ============================================================
# 1. APACHE OPTIONS & SERVER SIGNATURE
# ============================================================

# Disable directory listing
Options -Indexes

# Disable server-side includes unless explicitly needed
Options -Includes

# Disable MultiViews (prevents content-type guessing)
Options -MultiViews

# Disable symlink following (tighten security)
Options -FollowSymLinks +SymLinksIfOwnerMatch

# Hide Apache version and OS identity from headers
ServerSignature Off

# Suppress X-Powered-By (PHP/Apache version info)
<IfModule mod_headers.c>
    Header unset X-Powered-By
    Header always unset X-Powered-By
</IfModule>


# ============================================================
# 2. CANONICAL DOMAIN & HTTPS ENFORCEMENT
# ============================================================
# Force ALL traffic to HTTPS on the canonical (non-www) domain

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirect HTTP → HTTPS (non-www)
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP_HOST} ^(www\.)?karlasafariadventures\.com$ [NC]
    RewriteRule ^ https://karlasafariadventures.com%{REQUEST_URI} [R=301,L]

    # Redirect HTTPS www → HTTPS non-www
    RewriteCond %{HTTPS} on
    RewriteCond %{HTTP_HOST} ^www\.karlasafariadventures\.com$ [NC]
    RewriteRule ^ https://karlasafariadventures.com%{REQUEST_URI} [R=301,L]
</IfModule>


# ============================================================
# 3. WWW → NON-WWW REDIRECT (belt-and-suspenders via mod_alias)
# ============================================================

<IfModule mod_alias.c>
    # Covered by mod_rewrite above; alias kept as fallback
</IfModule>


# ============================================================
# 4. HSTS — HTTP STRICT TRANSPORT SECURITY
# ============================================================
# Instructs browsers to only use HTTPS for 2 years.
# includeSubDomains and preload require that ALL subdomains support HTTPS.

<IfModule mod_headers.c>
    Header always set Strict-Transport-Security \
        "max-age=63072000; includeSubDomains; preload" env=HTTPS
</IfModule>


# ============================================================
# 5. REWRITE ENGINE BASE
# ============================================================

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Pass-through for existing files and directories
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
</IfModule>


# ============================================================
# 6. CUSTOM ERROR PAGES
# ============================================================

ErrorDocument 400 /errors/400.html
ErrorDocument 401 /errors/401.html
ErrorDocument 403 /errors/403.html
ErrorDocument 404 /errors/404.html
ErrorDocument 405 /errors/405.html
ErrorDocument 408 /errors/408.html
ErrorDocument 410 /errors/410.html
ErrorDocument 429 /errors/429.html
ErrorDocument 500 /errors/500.html
ErrorDocument 502 /errors/502.html
ErrorDocument 503 /errors/503.html
ErrorDocument 504 /errors/504.html


# ============================================================
# 7. DIRECTORY & FILE PROTECTION
# ============================================================

# Deny access to hidden files (e.g. .git, .env, .htpasswd)
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Allow access to .well-known (needed for SSL cert renewals)
<FilesMatch "^\.well-known">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
</FilesMatch>

# Protect wp-config.php (WordPress) and other config files
<FilesMatch "^(wp-config\.php|config\.php|configuration\.php|settings\.php|database\.php|\.env|composer\.json|composer\.lock|package\.json|yarn\.lock|Gruntfile\.js|Gulpfile\.js|README\.md|CHANGELOG\.md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Block access to backup and log files
<FilesMatch "\.(bak|config|sql|fla|psd|ini|log|sh|inc|swp|dist|orig|save|old|~)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Deny direct access to the includes/lib directory
<IfModule mod_rewrite.c>
    RewriteRule ^(includes|lib|vendor|node_modules|storage|bootstrap|config|database|resources|routes|tests|artisan)(/|$) - [F,L]
</IfModule>


# ============================================================
# 8. HOTLINK PROTECTION
# ============================================================
# Prevent other sites from embedding your images/media.

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP_REFERER} !^$
    RewriteCond %{HTTP_REFERER} !^https://(www\.)?karlasafariadventures\.com/ [NC]
    RewriteCond %{HTTP_REFERER} !^https://search\.google\.com/ [NC]
    RewriteCond %{HTTP_REFERER} !^https://(www\.)?google\.com/ [NC]
    RewriteCond %{HTTP_REFERER} !^https://(www\.)?bing\.com/ [NC]
    RewriteCond %{HTTP_REFERER} !^https://(www\.)?facebook\.com/ [NC]
    RewriteCond %{HTTP_REFERER} !^https://(www\.)?tripadvisor\.com/ [NC]
    RewriteRule \.(jpg|jpeg|png|gif|webp|svg|ico|bmp|tiff|mp4|mov|avi|webm|mp3|pdf)$ \
        /assets/img/hotlink-blocked.png [R=403,L,NC]
</IfModule>


# ============================================================
# 9. BROWSER CACHING & EXPIRES HEADERS
# ============================================================

<IfModule mod_expires.c>
    ExpiresActive On

    # Default fallback
    ExpiresDefault                              "access plus 1 month"

    # HTML
    ExpiresByType text/html                     "access plus 0 seconds"
    ExpiresByType application/xhtml+xml         "access plus 0 seconds"

    # CSS & JavaScript
    ExpiresByType text/css                      "access plus 1 year"
    ExpiresByType application/javascript        "access plus 1 year"
    ExpiresByType text/javascript               "access plus 1 year"

    # Fonts
    ExpiresByType font/woff                     "access plus 1 year"
    ExpiresByType font/woff2                    "access plus 1 year"
    ExpiresByType application/font-woff         "access plus 1 year"
    ExpiresByType application/font-woff2        "access plus 1 year"
    ExpiresByType application/vnd.ms-fontobject "access plus 1 year"
    ExpiresByType font/ttf                      "access plus 1 year"
    ExpiresByType font/eot                      "access plus 1 year"

    # Images
    ExpiresByType image/jpeg                    "access plus 1 year"
    ExpiresByType image/png                     "access plus 1 year"
    ExpiresByType image/gif                     "access plus 1 year"
    ExpiresByType image/webp                    "access plus 1 year"
    ExpiresByType image/svg+xml                 "access plus 1 year"
    ExpiresByType image/x-icon                  "access plus 1 year"
    ExpiresByType image/vnd.microsoft.icon      "access plus 1 year"

    # Video / Audio
    ExpiresByType video/mp4                     "access plus 1 year"
    ExpiresByType video/webm                    "access plus 1 year"
    ExpiresByType audio/mpeg                    "access plus 1 year"
    ExpiresByType audio/ogg                     "access plus 1 year"

    # Documents & Data
    ExpiresByType application/pdf               "access plus 1 month"
    ExpiresByType application/json              "access plus 0 seconds"
    ExpiresByType application/xml               "access plus 0 seconds"
    ExpiresByType text/xml                      "access plus 0 seconds"

    # Manifests
    ExpiresByType application/manifest+json     "access plus 1 week"
    ExpiresByType text/cache-manifest           "access plus 0 seconds"
</IfModule>

# Cache-Control headers (complement to Expires)
<IfModule mod_headers.c>
    # Long-lived assets (CSS/JS with hash fingerprinting)
    <FilesMatch "\.(css|js|woff|woff2|ttf|eot|otf)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Images & media
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico|mp4|webm)$">
        Header set Cache-Control "public, max-age=31536000, stale-while-revalidate=86400"
    </FilesMatch>

    # HTML — no-cache with revalidation
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>

    # JSON / XML / API responses
    <FilesMatch "\.(json|xml)$">
        Header set Cache-Control "no-store, no-cache, must-revalidate"
    </FilesMatch>
</IfModule>


# ============================================================
# 10. GZIP / DEFLATE COMPRESSION
# ============================================================

<IfModule mod_deflate.c>
    # Enable compression for the following MIME types
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE text/x-component
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/atom+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/manifest+json
    AddOutputFilterByType DEFLATE application/x-font-ttf
    AddOutputFilterByType DEFLATE application/x-font-opentype
    AddOutputFilterByType DEFLATE application/vnd.ms-fontobject
    AddOutputFilterByType DEFLATE font/ttf
    AddOutputFilterByType DEFLATE font/eot
    AddOutputFilterByType DEFLATE font/woff
    AddOutputFilterByType DEFLATE font/woff2
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE image/x-icon

    # Handle old/broken browsers
    BrowserMatch ^Mozilla/4 gzip-only-text/html
    BrowserMatch ^Mozilla/4\.0[678] no-gzip
    BrowserMatch \bMSIE !no-gzip !gzip-only-text/html

    # Do not compress already compressed files
    SetEnvIfNoCase Request_URI \.(?:gif|jpg|jpeg|png|webp|zip|gz|bz2|rar|mp3|mp4|mov|avi)$ no-gzip dont-vary

    # Vary header for proxies
    Header append Vary User-Agent env=!dont-vary
</IfModule>

# Brotli compression (if mod_brotli available)
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css
    AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json
    AddOutputFilterByType BROTLI_COMPRESS image/svg+xml font/woff font/woff2
    BrotliCompressionQuality 6
</IfModule>


# ============================================================
# 11. SECURITY HEADERS
# ============================================================

<IfModule mod_headers.c>
    # Prevent MIME-type sniffing
    Header always set X-Content-Type-Options "nosniff"

    # XSS Protection (legacy browsers)
    Header always set X-XSS-Protection "1; mode=block"

    # Clickjacking protection
    Header always set X-Frame-Options "SAMEORIGIN"

    # Referrer Policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Remove unnecessary headers that leak server info
    Header unset Server
    Header unset X-Pingback
    Header unset X-AspNet-Version
    Header unset X-AspNetMvc-Version
    Header always unset ETag

    # Disable ETag (use Last-Modified instead)
    FileETag None
</IfModule>


