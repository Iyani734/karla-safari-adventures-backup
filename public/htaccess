# ============================================================
# 16. BASIC RATE-LIMITING / REQUEST FLOOD MITIGATION
# ============================================================
# Apache alone cannot true rate-limit, but we can reject common
# flood patterns. Use mod_evasive or a WAF for deeper protection.

<IfModule mod_rewrite.c>
    # Block requests with no User-Agent (many bots)
    RewriteCond %{HTTP_USER_AGENT} ^-?$
    RewriteRule .* - [F,L]

    # Block excessively long query strings (SQLi probe pattern)
    RewriteCond %{QUERY_STRING} .{2000,}
    RewriteRule .* - [F,L]

    # Block requests that contain multiple semicolons in query (SQLi)
    RewriteCond %{QUERY_STRING} (;.*){4,}
    RewriteRule .* - [F,L]
</IfModule>

# Deny access from hosts known to abuse — adjust IPs as needed
<IfModule mod_rewrite.c>
    # Throttle xmlrpc.php (WordPress brute force)
    RewriteCond %{REQUEST_URI} ^/xmlrpc\.php$
    RewriteRule .* - [F,L]
</IfModule>


# ============================================================
# 17. BAD BOT & MALICIOUS USER-AGENT BLOCKING
# ============================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Generic crawler / scraper bots
    RewriteCond %{HTTP_USER_AGENT} (AhrefsBot|MJ12bot|DotBot|SemrushBot|BLEXBot|DataForSeoBot) [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} (serpstatbot|PetalBot|Bytespider|CCBot|CensysInspect) [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} (Go-http-client|python-requests|libwww-perl|curl|wget|Java/) [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} (masscan|zgrab|nikto|sqlmap|nmap|WPScan|acunetix) [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} (Harvest|EmailCollector|EmailExtract|WebZIP|WebCopier) [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} (HTTrack|Teleport|WebReaper|SiteSnagger|WebStripper) [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} (Xenu|MSIECrawler|Microsoft.URL.Control|Offline.Explorer) [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} (grub|looksmart|BecomeBot|ConveraCrawler|DISCo) [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} (Mail\.RU_Bot|YandexBot(?!.*compatible)) [NC]
    RewriteRule .* - [F,L]
</IfModule>


