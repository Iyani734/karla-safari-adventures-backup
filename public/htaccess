#     RewriteCond %{REQUEST_URI} !(.*)/$
#     RewriteCond %{REQUEST_URI} !\.(php|html|htm|css|js|jpg|jpeg|png|gif|webp|svg|ico|xml|pdf|txt)$
#     RewriteRule ^(.*)$ /$1/ [R=301,L]
# </IfModule>


# ============================================================
# 22. SEO: REMOVE index.php / index.html FROM URL
# ============================================================

<IfModule mod_rewrite.c>
    RewriteCond %{THE_REQUEST} /index\.(php|html)(\s|\?) [NC]
    RewriteRule ^(.*)index\.(php|html)$ /$1 [R=301,L]
</IfModule>


# ============================================================
# 23. SEO: LOWERCASE URL ENFORCEMENT
# ============================================================
# Redirect any uppercase URL to its lowercase equivalent.

<IfModule mod_rewrite.c>
    RewriteMap lowercase int:tolower
    RewriteCond %{REQUEST_URI} [A-Z]
    RewriteRule ^ ${lowercase:%{REQUEST_URI}} [R=301,L]
</IfModule>


# ============================================================
# 24. REACT SPA ROUTING (app.jsx / React Router)
# ============================================================
# React handles ALL routing in the browser via React Router.
# The server's only job is to serve index.html for every route
# so React can boot up and render the correct component.
#
# Without this: refreshing /safaris/kenya, /about, /bookings/123
# would return a hard 404 from Apache instead of loading the app.
#
# Real files (JS bundles, images, fonts, CSS) are served directly
# — only unknown paths fall through to index.html.

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Serve real files and directories directly (JS/CSS/images/fonts)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-l

    # Everything else → index.html (React Router takes over)
    RewriteRule ^ index.html [L]
</IfModule>


