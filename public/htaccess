# ============================================================
# 19. BLOCKING SENSITIVE FILES & PATHS
# ============================================================

<IfModule mod_rewrite.c>
    # Block access to version control folders
    RewriteRule ^(\.git|\.svn|\.hg|\.bzr)(\/|$) - [F,L,NC]

    # Block PHP execution in upload directory
    RewriteRule ^(uploads|files|media|assets/uploads)/.*\.(php|php5|php7|phtml|phar)$ - [F,L,NC]

    # Block access to xmlrpc (if WordPress)
    RewriteRule ^xmlrpc\.php$ - [F,L]

    # Block author scan (WordPress user enumeration)
    RewriteCond %{QUERY_STRING} author=\d
    RewriteRule .* - [F,L]

    # Block script injections in query strings
    RewriteCond %{QUERY_STRING} (<|%3C).*script.*(>|%3E) [NC,OR]
    RewriteCond %{QUERY_STRING} GLOBALS(=|\[|\%[0-9A-Z]{0,2}) [OR]
    RewriteCond %{QUERY_STRING} _REQUEST(=|\[|\%[0-9A-Z]{0,2}) [OR]
    RewriteCond %{QUERY_STRING} base64_(en|de)code\(.*\) [NC,OR]
    RewriteCond %{QUERY_STRING} (\.\./|%2e%2e%2f|%2e%2e/) [NC,OR]
    RewriteCond %{QUERY_STRING} (proc/self/environ|etc/passwd|etc/shadow) [NC,OR]
    RewriteCond %{QUERY_STRING} (concat|union|select|insert|drop|update|delete).*\( [NC,OR]
    RewriteCond %{QUERY_STRING} (\/\*|\/\*!|BENCHMARK|SLEEP|EXTRACTVALUE|UPDATEXML) [NC]
    RewriteRule .* - [F,L]
</IfModule>


